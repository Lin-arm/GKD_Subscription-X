{
  "compilerOptions": {
    "outDir": "dist",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["node"],
    "lib": ["ESNext"],
    "allowSyntheticDefaultImports": true
  },
  "include": ["src", "scripts"]
}
